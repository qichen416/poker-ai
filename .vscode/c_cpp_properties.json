{
    "configurations": [
        {
            "name": "Win64-MSVC-Py310",
            "includePath": [
                "${workspaceFolder}/cpp/include",
                "${workspaceFolder}/cpp/python_bindings",
                "${env:CONDA_PREFIX}/Lib/site-packages/pybind11/include",
                "${env:CONDA_PREFIX}/include",
                "${env:CONDA_PREFIX}/include/python3.10"
            ],
            "defines": ["NDEBUG", "UNICODE", "_UNICODE"],
            "compilerPath": "cl.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-msvc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}