# ---------------------------------------------------------------------------
# 枚举
# ---------------------------------------------------------------------------
class Stage(Enum):
    """游戏阶段"""
    PREFLOP = ...
    FLOP = ...
    TURN = ...
    RIVER = ...
    SHOWDOWN = ...

class Position(Enum):
    """座位位置"""
    SB = ...
    BB = ...
    BUTTON = ...

class ActionType(Enum):
    """动作类型"""
    FOLD = ...
    CHECK = ...
    CALL = ...
    BET = ...
    RAISE = ...
    ALLIN = ...

# ---------------------------------------------------------------------------
# ActionRecord & GameState
# ---------------------------------------------------------------------------
class ActionRecord:
    """单条动作记录"""
    stage: Stage
    action: ActionType
    amount: int
    is_opponent: bool

class GameState:
    """当前游戏状态快照"""
    my_cards: List[Card]
    community_cards: List[Card]
    num_community: int
    my_position: Position
    stage: Stage
    my_chips: int
    opponent_chips: int
    pot: int
    to_call: int
    history: List[ActionRecord]
    opponent_vpip: float
    opponent_pfr: float
    opponent_af: float

    def __init__(self) -> None: ...
    def get_stage_history(self) -> List[ActionRecord]: ...
    def is_first_action(self) -> bool: ...

