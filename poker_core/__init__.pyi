# ---------------------------------------------------------------------------
class StepResult:
    """step() 返回值"""
    state: GameState
    reward: float
    done: bool

class SelfPlayEnv:
    """自对弈环境"""
    def __init__(self) -> None: ...
    def reset(self, seed: int = 0) -> GameState: ...
    def step(self, action: ActionType, amount: int = 0) -> StepResult: ...
    def legal_actions(self) -> List[ActionType]: ...
    def is_action_legal(self, action: ActionType, amount: int = 0) -> bool: ...
    def step_batch(self, actions: List[ActionType], amounts: List[int]) -> List[StepResult]: ...
    def set_opponent_policy(self, policy: Callable[[GameState], ActionType]) -> None: ...
